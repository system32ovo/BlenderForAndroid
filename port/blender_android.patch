diff --git a/build_files/cmake/Modules/FindZstd.cmake b/build_files/cmake/Modules/FindZstd.cmake
index 0da9da91..3d3ec6f0 100644
--- a/build_files/cmake/Modules/FindZstd.cmake
+++ b/build_files/cmake/Modules/FindZstd.cmake
@@ -15,6 +15,18 @@
 # also defined, but not for general use are
 #  ZSTD_LIBRARY, where to find the Zstd library.
 
+# On a case-insensitive filesystem (e.g. Windows) this module may also be
+# picked up by a third-party config package that calls `find_package(zstd)`
+# with a lowercase name (vcpkg's minizip-ng does this). Blender itself uses
+# `find_package(Zstd)`. Distinguish the two via CMAKE_FIND_PACKAGE_NAME and,
+# for the lowercase spelling, defer to the config package (zstdConfig.cmake)
+# so the `zstd::libzstd_static` imported target that the caller expects is
+# actually created.
+if(CMAKE_FIND_PACKAGE_NAME STREQUAL "zstd")
+  find_package(zstd CONFIG QUIET)
+  return()
+endif()
+
 # If `ZSTD_ROOT_DIR` was defined in the environment, use it.
 if(DEFINED ZSTD_ROOT_DIR)
   # Pass.
